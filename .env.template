# Database Configuration - Choose one or use environment-specific
# MySQL
MYSQL_DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/fastapi_starter

# PostgreSQL
POSTGRES_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fastapi_starter

# SQLite (for development/testing)
SQLITE_DATABASE_URL=sqlite:///./sms.db

# Active Database (choose one)
DATABASE_URL=${mysql+pymysql://user:password@localhost:3306/fastapi_starter}

# Logging
LOG_LEVEL=INFO

# Authentication
DISPATCH_AUTHENTICATION_PROVIDER_SLUG=dispatch-auth-provider-basic
DISPATCH_AUTHENTICATION_DEFAULT_USER=admin@example.com
DISPATCH_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
DISPATCH_JWT_ALG=HS256
DISPATCH_JWT_EXP=86400

# Server Settings
HOST=0.0.0.0
PORT=8080
RELOAD=true